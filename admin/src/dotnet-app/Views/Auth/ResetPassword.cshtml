@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurar Nueva Contraseña - QualityDoc</title>
    
    <!-- Fuente oficial de Android / Google -->
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { 
                        sans: ['Google Sans Flex', 'sans-serif'] 
                    },
                    colors: { 
                        // Colores específicos solicitados
                        primary: { 
                            DEFAULT: '#754ee5', // Morado modo claro
                            dark: '#baa5ff',    // Morado modo oscuro
                        },
                        darkTheme: {
                            bg: '#2a2b2e',
                            card: '#323338',
                            border: '#4a4b50'
                        }
                    }
                }
            }
        }
    </script>
    
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Transiciones base suaves estilo Android */
        body { 
            background-color: #FAFAFA; 
            color: #1e293b; 
            transition: background-color 0.3s ease, color 0.3s ease; 
        }
        html.dark body { 
            background-color: #2a2b2e; 
            color: #e2e8f0; 
        }
        
        /* Ocultar scrollbar */
        ::-webkit-scrollbar { width: 0px; background: transparent; }

        /* Efecto Ripple (onda) simplificado para botones */
        .btn-ripple {
            position: relative;
            overflow: hidden;
            transform: translate3d(0, 0, 0);
        }
        .btn-ripple:active::after {
            content: "";
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-color: rgba(255,255,255,0.2);
            border-radius: inherit;
            animation: ripple 0.4s ease-out;
        }
        html.dark .btn-ripple:active::after {
            background-color: rgba(0,0,0,0.15);
        }
        @@keyframes ripple {
            0% { transform: scale(0); opacity: 1; }
            100% { transform: scale(2); opacity: 0; }
        }
    </style>
</head>

<body class="antialiased min-h-screen flex items-center justify-center p-4 relative">
    
    <!-- Tarjeta estilo Material 3: Sin sombras exageradas, bordes muy redondeados -->
    <div class="max-w-md w-full bg-white dark:bg-darkTheme-card rounded-[2rem] shadow-sm border border-slate-100 dark:border-darkTheme-border overflow-hidden relative z-10 transition-colors duration-300 p-8 sm:p-10">
        
        <!-- Icono flotante con fondo tenue (patrón Material) -->
        <div class="w-14 h-14 rounded-full bg-primary/10 dark:bg-primary-dark/15 flex items-center justify-center mb-6 transition-colors duration-300">
            <i data-lucide="lock-keyhole" class="w-7 h-7 text-primary dark:text-primary-dark transition-colors duration-300"></i>
        </div>

        <!-- Títulos alineados a la izquierda -->
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-2 transition-colors duration-300">
            Nueva contraseña
        </h2>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-8 transition-colors duration-300">
            Tu nueva contraseña debe ser diferente a las utilizadas anteriormente.
        </p>

        <form action="/admin/Auth/ResetPassword" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <!-- Campo: Nueva Contraseña -->
            <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i data-lucide="key" class="w-5 h-5 text-slate-400 dark:text-slate-500 group-focus-within:text-primary dark:group-focus-within:text-primary-dark transition-colors duration-300"></i>
                </div>
                <input type="password" id="newPassword" name="newPassword" minlength="8" 
                       class="block w-full pl-12 pr-4 py-4 rounded-2xl bg-slate-50 dark:bg-darkTheme-bg border-2 border-transparent text-slate-800 dark:text-white focus:bg-white dark:focus:bg-darkTheme-card focus:border-primary dark:focus:border-primary-dark transition-all outline-none placeholder:text-slate-400 dark:placeholder:text-slate-500" 
                       placeholder="Contraseña (mínimo 8 caracteres)" required />
            </div>

            <!-- Campo: Confirmar Contraseña -->
            <div>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i data-lucide="check-circle" class="w-5 h-5 text-slate-400 dark:text-slate-500 group-focus-within:text-primary dark:group-focus-within:text-primary-dark transition-colors duration-300"></i>
                    </div>
                    <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" 
                           class="block w-full pl-12 pr-4 py-4 rounded-2xl bg-slate-50 dark:bg-darkTheme-bg border-2 border-transparent text-slate-800 dark:text-white focus:bg-white dark:focus:bg-darkTheme-card focus:border-primary dark:focus:border-primary-dark transition-all outline-none placeholder:text-slate-400 dark:placeholder:text-slate-500" 
                           placeholder="Confirmar contraseña" required />
                </div>
                <p id="passwordMismatch" class="text-sm text-red-500 dark:text-red-400 mt-2 ml-2 hidden font-medium transition-colors">Las contraseñas no coinciden.</p>
            </div>

            <div class="pt-2">
                <!-- Botón de acción: Modo Claro (Texto Blanco), Modo Oscuro (Texto Oscuro para contraste con #baa5ff) -->
                <button type="submit" id="submitBtn" class="btn-ripple w-full bg-primary dark:bg-primary-dark text-white dark:text-darkTheme-bg font-semibold text-lg py-4 rounded-full transition-colors flex justify-center items-center">
                    Guardar contraseña
                </button>
            </div>
            
            <div class="text-center mt-6">
                 <a href="/admin/Auth/Login" class="text-sm font-medium text-primary dark:text-primary-dark hover:underline transition-all flex items-center justify-center gap-2">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver a inicio de sesión
                </a>
            </div>
        </form>
    </div>

    <!-- Botón flotante para cambiar tema (Pruebas) -->
    <button id="themeToggle" class="absolute bottom-6 right-6 p-4 bg-white dark:bg-darkTheme-card rounded-full shadow-lg border border-slate-100 dark:border-darkTheme-border text-slate-600 dark:text-slate-300 hover:text-primary dark:hover:text-primary-dark transition-colors z-50">
        <i data-lucide="moon" class="w-6 h-6 dark:hidden"></i>
        <i data-lucide="sun" class="w-6 h-6 hidden dark:block"></i>
    </button>

    <script>
        // Inicializar iconos
        lucide.createIcons();

        // Lógica de cambio de tema
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;

        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        }

        themeToggle.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        });

        // Validación de contraseñas
        const form = document.querySelector('form');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const mismatchMsg = document.getElementById('passwordMismatch');

        form.addEventListener('submit', function(e) {
            if (newPassword.value !== confirmPassword.value) {
                e.preventDefault();
                mismatchMsg.classList.remove('hidden');
                
                // Cambiar a estilos de error
                confirmPassword.classList.remove('focus:border-primary', 'dark:focus:border-primary-dark', 'border-transparent');
                confirmPassword.classList.add('border-red-500', 'dark:border-red-400');
            }
        });

        confirmPassword.addEventListener('input', () => {
            mismatchMsg.classList.add('hidden');
            
            // Restaurar estilos normales
            confirmPassword.classList.remove('border-red-500', 'dark:border-red-400');
            confirmPassword.classList.add('border-transparent', 'focus:border-primary', 'dark:focus:border-primary-dark');
        });
    </script>
</body>
</html>