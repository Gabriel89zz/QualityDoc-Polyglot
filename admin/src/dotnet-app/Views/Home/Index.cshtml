                        <i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("MMMM")
                    </span>
                </div>
                <div class="flex justify-between gap-2">
                    @{
                        var today = DateTime.Now;
                        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                        var startOfWeek = today.AddDays(-1 * diff).Date;
                        string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie" };
                        
                        for (int i = 0; i < 5; i++)
                        {
                            var currentDate = startOfWeek.AddDays(i);
                            bool isToday = currentDate.Date == today.Date;
                            
                            if (isToday)
                            {
                                <div class="flex flex-col items-center justify-center py-2 px-3 rounded-2xl bg-brand text-white shadow-md shadow-brand/30 scale-105">
