@using QualityDoc.API.Models
@{
    ViewData["Title"] = "Dashboard Principal";
    
    var esSuper = User.IsInRole("Super Admin") || User.IsInRole("Super Administrador");
    var esAdminEmpresa = User.IsInRole("Admin de Empresa");
    var esOperario = User.IsInRole("Lector");
    var companiaNombre = User.FindFirst("CompanyName")?.Value ?? "su Empresa";
    
    var firmasRecientes = ViewBag.FirmasRecientes as IEnumerable<DocumentApproval>;
    int misRechazos = ViewBag.MisDocsRechazados ?? 0;
}

@if (esSuper)
{
    <div class="xl:pr-80">
        <div class="space-y-8">
            
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 animate-fade-up">
                <h1 class="text-2xl font-bold text-slate-800 dark:text-white hidden md:block">Panel Global del Host Tenant</h1>
                <div class="relative w-full md:w-80">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-sm"></i>
                    </span>
                    <input type="text" placeholder="Buscar empresas o usuarios globales..." class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-darkbg-card border border-slate-200 dark:border-darkbg-border rounded-xl text-sm focus:outline-none focus:border-brand dark:focus:border-brand shadow-soft transition-all text-slate-700 dark:text-slate-200" />
                </div>
            </div>

            <div class="relative w-full bg-brand dark:bg-[#B8ACFF] rounded-[2rem] p-8 sm:p-10 overflow-hidden shadow-soft mt-6 mb-8 flex flex-col md:flex-row items-center justify-between animate-fade-up delay-100">
                
                <div class="absolute inset-0 z-0 pointer-events-none">
                    <div class="absolute -top-[50%] left-[40%] w-full h-[200%] bg-white opacity-5 transform -skew-x-12"></div>
                </div>

                <div class="relative z-10 flex-1 w-full text-left">
                    
                    <div class="flex items-center gap-2 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
                        <i class="fa-regular fa-calendar"></i>
                        <span>@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy").ToUpper()</span>
                    </div>

                    <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight drop-shadow-sm">
                        ¡Bienvenido de vuelta, @(User.Identity?.Name ?? "Super Admin")!
                    </h2>

                    <p class="text-white/90 text-sm md:text-base font-medium leading-relaxed mb-6 max-w-xl">
                        Mantén siempre actualizado el portal Host Tenant.<br />
                        Actualmente gestionas <span class="inline-block bg-white text-brand px-2.5 py-0.5 rounded-lg text-sm font-bold mx-1 shadow-sm">@ViewBag.TotalEmpresas</span> empresas clientes dentro del sistema.
                    </p>

                    <div class="flex flex-wrap items-center gap-3">
                        <a href="/admin/Companies/Create" class="inline-flex items-center gap-2 bg-white text-brand font-bold text-sm px-6 py-3 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
                            <i class="fa-solid fa-plus"></i> Nueva Empresa
                        </a>
                        <a href="/admin/Companies/Index" class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white font-bold text-sm px-6 py-3 rounded-xl hover:bg-white/20 transition-all">
                            Ver catálogo completo
                        </a>
                    </div>
                </div>

                <div class="relative hidden lg:flex items-center justify-center w-72 h-56 mr-4 mt-8 md:mt-0 z-10">
                    
                    <div class="absolute inset-0 flex items-center justify-center opacity-10">
                        <div class="w-full h-[1px] bg-white"></div>
                        <div class="absolute w-[1px] h-full bg-white"></div>
                    </div>

                    <div class="relative w-56 h-40 border border-white/20 rounded-2xl bg-white/5 backdrop-blur-sm p-4 flex flex-col justify-between">
                        
                        <div class="flex items-center justify-between border-b border-white/10 pb-3">
                            <div class="flex gap-1.5">
                                <div class="w-2 h-2 rounded-full bg-white/30"></div>
                                <div class="w-2 h-2 rounded-full bg-white/30"></div>
                                <div class="w-2 h-2 rounded-full bg-white/30"></div>
                            </div>
                            <div class="w-16 h-1.5 bg-white/20 rounded-full"></div>
                        </div>

                        <div class="space-y-2.5 my-auto flex-1 flex flex-col justify-center">
                            <div class="w-full h-7 bg-white/10 rounded-xl border border-white/5 flex items-center px-3 gap-3">
                                <div class="w-3 h-3 bg-white/30 rounded-md flex-shrink-0"></div>
                                <div class="w-2/3 h-1.5 bg-white/20 rounded-full"></div>
                            </div>
                            
                            <div class="w-full h-7 bg-white/10 rounded-xl border border-white/5 flex items-center px-3 gap-3">
                                <div class="w-3 h-3 bg-white/30 rounded-md flex-shrink-0"></div>
                                <div class="w-1/2 h-1.5 bg-white/20 rounded-full"></div>
                            </div>
                        </div>

                        <div class="flex justify-between items-center pt-2 border-t border-white/5">
                            <div class="w-10 h-1.5 bg-white/20 rounded-full"></div>
                            <div class="w-4 h-4 bg-white/30 rounded-full flex items-center justify-center">
                                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
                            </div>
                        </div>
                    </div>

                    <div class="absolute bottom-4 right-4 w-6 h-6 bg-white/20 rounded-lg border border-white/30 flex items-center justify-center transform translate-x-2 translate-y-2 shadow-sm">
                        <div class="w-2 h-2 bg-white rounded-sm"></div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 animate-fade-up delay-100">
                
                <div class="relative overflow-hidden rounded-3xl p-6 bg-[#007BFF] dark:bg-[#49A1FF] text-white shadow-soft dark:shadow-none hover:shadow-hover-soft transition-all duration-300 hover:-translate-y-1">
                    <i class="fa-solid fa-building absolute -bottom-5 -right-4 text-7xl opacity-20 transform rotate-12"></i>
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center flex-shrink-0 text-[#007BFF] dark:text-[#49A1FF] shadow-sm">
                            <i class="fa-solid fa-building text-2xl"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-white/90 text-sm font-medium mb-0.5">Empresas Clientes</span>
                            <span class="text-3xl font-extrabold leading-none">@ViewBag.TotalEmpresas</span>
                        </div>
                    </div>
                </div>
                
                <div class="relative overflow-hidden rounded-3xl p-6 bg-[#00D2A6] dark:bg-[#00E7B5] text-white shadow-soft dark:shadow-none hover:shadow-hover-soft transition-all duration-300 hover:-translate-y-1">
                    <i class="fa-solid fa-users-gear absolute -bottom-5 -right-4 text-7xl opacity-20 transform -rotate-12"></i>
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center flex-shrink-0 text-[#00D2A6] dark:text-[#00E7B5] shadow-sm">
                            <i class="fa-solid fa-users-gear text-2xl"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-white/90 text-sm font-medium mb-0.5">Usuarios Globales</span>
                            <span class="text-3xl font-extrabold leading-none">@ViewBag.TotalUsuariosGlobales</span>
                        </div>
                    </div>
                </div>
                
                <div class="relative overflow-hidden rounded-3xl p-6 bg-[#FF9A62] dark:bg-[#FF9A62] text-white shadow-soft dark:shadow-none hover:shadow-hover-soft transition-all duration-300 hover:-translate-y-1">
                    <i class="fa-solid fa-scale-balanced absolute -bottom-5 -right-4 text-7xl opacity-20 transform rotate-12"></i>
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center flex-shrink-0 text-[#FF9A62] dark:text-[#FF9A62] shadow-sm">
                            <i class="fa-solid fa-scale-balanced text-2xl"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-white/90 text-sm font-medium mb-0.5">Normas ISO Activas</span>
                            <span class="text-3xl font-extrabold leading-none">@ViewBag.TotalNormas</span>
                        </div>
                    </div>
                </div>
                
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-fade-up delay-200">
                <div class="bg-white dark:bg-darkbg-card p-6 rounded-2xl shadow-soft dark:shadow-none border border-slate-200 dark:border-darkbg-border flex flex-col h-full">
                    <h3 class="text-slate-800 dark:text-white font-bold mb-5 text-lg flex items-center tracking-tight">
                        <i class="fa-solid fa-city text-blue-500 mr-2"></i> Operaciones de Tenant
                    </h3>
                    <div class="space-y-3 flex-1">
                        <a href="/admin/Companies/Create" class="flex items-center p-4 rounded-xl bg-slate-50 dark:bg-darkbg-base hover:bg-slate-100 dark:hover:bg-darkbg-card transition-colors border dark:border-darkbg-border group relative overflow-hidden">
                            <div class="absolute inset-y-0 left-0 w-1 bg-brand opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            <div class="w-12 h-12 bg-white dark:bg-darkbg-card rounded-xl shadow-sm flex items-center justify-center mr-4 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-building-circle-check text-brand dark:text-[#B8ACFF] text-lg"></i>
                            </div>
                            <div>
                                <p class="font-bold text-sm text-slate-800 dark:text-white">Registrar Nuevo Cliente</p>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">Dar de alta una nueva empresa en el sistema global.</p>
                            </div>
                        </a>
                        
                        <a href="/admin/Companies/Index" class="flex items-center p-4 rounded-xl bg-slate-50 dark:bg-darkbg-base hover:bg-slate-100 dark:hover:bg-darkbg-card transition-colors border dark:border-darkbg-border group relative overflow-hidden">
                            <div class="absolute inset-y-0 left-0 w-1 bg-purple-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            <div class="w-12 h-12 bg-white dark:bg-darkbg-card rounded-xl shadow-sm flex items-center justify-center mr-4 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-list-ul text-purple-600 dark:text-[#B8ACFF] text-lg"></i>
                            </div>
                            <div>
                                <p class="font-bold text-sm text-slate-800 dark:text-white">Directorio Completo</p>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">Administrar datos fiscales y estatus de los Tenants.</p>
                            </div>
                        </a>
                    </div>
                </div>

               @{
                    // Extraemos los datos del controlador de forma segura
                    var datosGrafica = ViewBag.DatosGrafica as Dictionary<string, int> ?? new Dictionary<string, int>();
                    int totalUsuariosGlobales = ViewBag.TotalUsuariosGlobales ?? 0;
                    
                    // Mantenemos exactamente la paleta de colores original de tus KPIs
                    string[] coloresSaaS = { "#8772FE", "#00D2A6", "#FF9A62" };
                    
                    // Construcción matemática del gradiente cónico dinámico
                    string gradientStyle = "background: #e2e8f0;"; // Color gris de respaldo por si no hay datos
                    
                    if (totalUsuariosGlobales > 0 && datosGrafica.Any())
                    {
                        var tramosGradiente = new List<string>();
                        double acumulado = 0;
                        int colorIdx = 0;
                        
                        foreach (var item in datosGrafica)
                        {
                            double porcentaje = (double)item.Value / totalUsuariosGlobales * 100;
                            double inicio = acumulado;
                            acumulado += porcentaje;
                            double fin = acumulado;
                            
                            string colorActual = coloresSaaS[colorIdx % coloresSaaS.Length];
                            
                            // Usamos CultureInfo.InvariantCulture para asegurar que los decimales lleven punto (.) y no coma (,) en el CSS
                            tramosGradiente.Add($"{colorActual} {inicio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {fin.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
                            colorIdx++;
                        }
                        gradientStyle = $"background: conic-gradient({string.Join(", ", tramosGradiente)});";
                    }
                }

                <div class="lg:col-span-1 bg-white dark:bg-[#323338] rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-[#4a4b50] flex flex-col h-full min-h-[280px] transition-colors duration-300">
                    
                    <div class="mb-4 flex justify-between items-center">
                        <h3 class="text-slate-800 dark:text-white font-bold text-lg tracking-tight">Usuarios por Empresa</h3>
                        <i class="fa-solid fa-chart-pie text-slate-400 dark:text-slate-500"></i>
                    </div>
                    
                    <div class="flex-1 flex flex-col justify-center items-center mt-2">
                        <div class="relative w-32 h-32 rounded-full shadow-sm transform hover:scale-105 transition-transform duration-300" 
                             style="@gradientStyle">
                            
                            <div class="absolute inset-0 m-auto w-20 h-20 bg-white dark:bg-[#323338] rounded-full flex flex-col items-center justify-center shadow-inner transition-colors duration-300">
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider">Total</span>
                                <span class="text-xl font-extrabold text-slate-800 dark:text-white leading-none mt-0.5">@totalUsuariosGlobales</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 space-y-2.5">
                        @{
                            int itemIdx = 0;
                            foreach (var empresa in datosGrafica)
                            {
                                double porcentajeEmpresa = totalUsuariosGlobales > 0 ? ((double)empresa.Value / totalUsuariosGlobales * 100) : 0;
                                string colorCirculo = coloresSaaS[itemIdx % coloresSaaS.Length];
                                
                                <div class="flex items-center justify-between text-sm group">
                                    <div class="flex items-center gap-2">
                                        <div class="w-3 h-3 rounded-full shadow-sm flex-shrink-0" style="background-color: @colorCirculo"></div>
                                        <span class="text-slate-600 dark:text-slate-300 font-medium group-hover:text-slate-900 dark:group-hover:text-white transition-colors truncate max-w-[140px]">
                                            @empresa.Key
                                        </span>
                                    </div>
                                    <span class="font-bold text-slate-800 dark:text-white">@Math.Round(porcentajeEmpresa)%</span>
                                </div>
                                
                                itemIdx++;
                            }
                        }
                    </div>
                </div>
                
            </div>
        </div>
    </div>

    <aside id="right-sidebar" class="hidden xl:flex flex-col fixed right-0 top-0 h-screen w-80 bg-white dark:bg-darkbg-card border-l border-slate-200 dark:border-darkbg-border overflow-y-auto z-30 shadow-[-4px_0_24px_rgba(0,0,0,0.02)]">
        
        <div class="p-6 pb-2 flex items-center justify-between sticky top-0 bg-white/90 dark:bg-darkbg-card/90 backdrop-blur-md z-20 border-b border-slate-100 dark:border-darkbg-border/50">
            <div class="flex gap-2">
                <button class="w-10 h-10 rounded-full border border-slate-200 dark:border-[#4a4b50] flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-brand hover:bg-brand/5 transition-all relative" title="Notificaciones">
                    <i class="fa-regular fa-bell"></i>
                    <span class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white dark:border-darkbg-card"></span>
                </button>
            </div>
            <div class="flex items-center gap-3 group text-right">
                <div class="flex flex-col justify-center">
                    <span class="text-sm font-bold text-slate-800 dark:text-white group-hover:text-brand transition-colors leading-tight">@User.Identity?.Name</span>
                    <span class="text-[10px] text-slate-500 uppercase tracking-wide">HOST TENANT</span>
                </div>
                <img src="https://ui-avatars.com/api/?name=@User.Identity?.Name&background=8772FE&color=fff&rounded=true&bold=true" alt="Admin" class="w-10 h-10 rounded-full shadow-sm ring-2 ring-transparent group-hover:ring-brand/30 transition-all">
            </div>
        </div>

        <div class="p-6 space-y-8 pt-6">
            
            <div class="bg-gradient-to-br from-brand to-brand-hover dark:from-[#B8ACFF] dark:to-brand rounded-3xl p-5 text-white shadow-lg shadow-brand/20 relative overflow-hidden group">
                <i id="weatherIconBg" class="fa-solid fa-cloud-sun absolute -right-3 -bottom-4 text-7xl opacity-20 group-hover:scale-110 transition-transform duration-500"></i>
                <div class="relative z-10 flex justify-between items-center mb-4">
                    <span class="text-sm font-medium opacity-90 tracking-wide">Monclova, MX</span>
                    <span class="text-xs font-bold bg-white/20 px-2.5 py-1 rounded-lg backdrop-blur-sm">Hoy</span>
                </div>
                <div class="relative z-10 flex items-end gap-3">
                    <h2 id="weatherTemp" class="text-5xl font-extrabold leading-none tracking-tighter">--°</h2>
                    <span id="weatherDesc" class="text-sm font-medium mb-1.5 opacity-90">Cargando...</span>
                </div>
            </div>

            <div>
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 dark:text-white text-base">Calendario</h3>
                    <span class="text-xs bg-slate-100 dark:bg-darkbg-base px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 font-medium">
                        <i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("MMMM")
                    </span>
                </div>
                <div class="flex justify-between gap-2">
                    @{
                        var today = DateTime.Now;
                        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                        var startOfWeek = today.AddDays(-1 * diff).Date;
                        string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie" };
                        
                        for (int i = 0; i < 5; i++)
                        {
                            var currentDate = startOfWeek.AddDays(i);
                            bool isToday = currentDate.Date == today.Date;
                            
                            if (isToday)
                            {
                                <div class="flex flex-col items-center justify-center py-2 px-3 rounded-2xl bg-brand text-white shadow-md shadow-brand/30 scale-105">
                                    <span class="text-[9px] uppercase font-bold mb-1">@diasSemana[i]</span>
                                    <span class="text-sm font-bold">@currentDate.Day</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center justify-center py-2 px-3 rounded-2xl bg-slate-50 dark:bg-darkbg-base text-slate-500">
                                    <span class="text-[9px] uppercase font-bold mb-1">@diasSemana[i]</span>
                                    <span class="text-sm font-bold">@currentDate.Day</span>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            
            
        </div>
    </aside>
}
else if (esAdminEmpresa)
{
    <div class="xl:pr-80">
        <div class="space-y-8">
            
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 animate-fade-up">
                <h1 class="text-2xl font-bold text-slate-800 dark:text-white hidden md:block">Dashboard</h1>
                <div class="relative w-full md:w-80">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-sm"></i>
                    </span>
                    <input type="text" placeholder="Buscar documentos en proceso..." class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-darkbg-card border border-slate-200 dark:border-darkbg-border rounded-xl text-sm focus:outline-none focus:border-brand dark:focus:border-brand shadow-soft transition-all text-slate-700 dark:text-slate-200" />
                </div>
            </div>

            <div class="relative w-full bg-brand dark:bg-[#B8ACFF] rounded-[2rem] p-8 sm:p-10 overflow-hidden shadow-soft mt-6 mb-8 flex flex-col md:flex-row items-center justify-between animate-fade-up delay-100">
                
                <div class="absolute inset-0 z-0 pointer-events-none">
                    <div class="absolute -top-[50%] left-[40%] w-full h-[200%] bg-white opacity-5 transform -skew-x-12"></div>
                </div>

                <div class="relative z-10 flex-1 w-full text-left">
                    
                    <div class="flex items-center gap-2 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
                        <i class="fa-regular fa-calendar"></i>
                        <span>@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy").ToUpper()</span>
                    </div>

                    <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight drop-shadow-sm">
                        ¡Bienvenido de vuelta, @(User.Identity?.Name ?? "Admin")!
                    </h2>

                    <p class="text-white/90 text-sm md:text-base font-medium leading-relaxed mb-6 max-w-xl">
                        Mantén siempre actualizado el portal de <strong class="font-extrabold text-white">@companiaNombre</strong>.<br />
                        Actualmente tienes <span class="inline-block bg-white text-brand px-2.5 py-0.5 rounded-lg text-sm font-bold mx-1 shadow-sm">@ViewBag.FlujosActivos</span> 
                        @(ViewBag.FlujosActivos == 1 ? "flujo pendiente de revisión." : "flujos pendientes de revisión.")
                    </p>

                    <div class="flex flex-wrap items-center gap-3">
                        <a href="/admin/Documents/Create" class="inline-flex items-center gap-2 bg-white text-brand font-bold text-sm px-6 py-3 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
                            <i class="fa-solid fa-plus"></i> Nuevo Documento
                        </a>
                        <a href="/admin/DocumentApprovals/Index" class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white font-bold text-sm px-6 py-3 rounded-xl hover:bg-white/20 transition-all">
                            Ver flujos activos
                        </a>
                    </div>
                </div>

                <div class="relative z-10 hidden lg:flex items-center justify-center w-72 h-56 mr-4 mt-8 md:mt-0">
                    <div class="absolute w-56 h-56 bg-white/10 rounded-[3rem] transform rotate-12 blur-sm"></div>

                    <div class="absolute top-4 left-6 w-4 h-4 bg-orange-400 rounded-full shadow-sm"></div>
                    <div class="absolute top-8 right-12 w-4 h-4 bg-blue-500 rounded shadow-sm transform rotate-12"></div>
                    <div class="absolute bottom-6 left-12 w-0 h-0 border-l-[6px] border-r-[6px] border-b-[10px] border-l-transparent border-r-transparent border-b-purple-300 transform -rotate-12"></div>

                    <div class="absolute w-32 h-44 bg-slate-200 rounded-xl shadow-md transform -rotate-6 -translate-x-6"></div>

                    <div class="absolute w-36 h-48 bg-white rounded-xl shadow-xl flex flex-col p-5 transform rotate-3 translate-x-4">
                        <div class="absolute top-0 right-0 w-10 h-10 bg-slate-100 rounded-bl-xl rounded-tr-xl border-b border-l border-slate-200"></div>
                        
                        <div class="w-12 h-3 bg-slate-300 rounded-full mb-6 mt-2"></div>
                        <div class="w-full h-2.5 bg-slate-100 rounded-full mb-3"></div>
                        <div class="w-5/6 h-2.5 bg-slate-100 rounded-full mb-3"></div>
                        <div class="w-full h-2.5 bg-slate-100 rounded-full mb-3"></div>
                        <div class="w-3/4 h-2.5 bg-slate-100 rounded-full"></div>
                    </div>

                    <div class="absolute -bottom-2 right-6 w-16 h-16 bg-[#00D2A6] rounded-full shadow-xl flex items-center justify-center border-[5px] border-brand dark:border-[#B8ACFF] transform translate-x-2 translate-y-2">
                        <i class="fa-solid fa-check text-white text-2xl font-extrabold"></i>
                    </div>
                </div>
            </div>

