@using QualityDoc.API.Helpers
@model PaginatedList<QualityDoc.API.Models.DocumentCategory>

@{
    ViewData["Title"] = "Categorías Documentales";
}

<div class="w-full max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white dark:bg-[#323338] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] transition-colors duration-300 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center">
                <div class="w-10 h-10 rounded-xl bg-brand/10 flex items-center justify-center mr-3 border border-brand/20">
                    <i class="fa-solid fa-folder-tree text-brand"></i>
                </div>
                Categorías Documentales
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Estructura de la pirámide documental</p>
        </div>
        
        <div class="mt-4 sm:mt-0">
            <a href="/admin/DocumentCategories/Create" class="bg-brand hover:bg-brand-hover text-white font-bold py-2.5 px-5 rounded-xl shadow-md shadow-brand/20 flex items-center justify-center w-full sm:w-auto transition duration-200">
                <i class="fa-solid fa-folder-plus mr-2"></i> Nueva Categoría
            </a>
        </div>
    </div>

    <form method="get" action="/admin/DocumentCategories/Index" id="searchForm" class="flex flex-col md:flex-row gap-3 mb-6 relative z-40 animate-fade-up">
        
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </span>
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" autocomplete="off" placeholder="Buscar por categoría o prefijo..." 
                   class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] rounded-xl text-sm focus:outline-none focus:border-brand dark:focus:border-brand shadow-sm transition-all text-slate-700 dark:text-slate-200" />
        </div>

        <div class="relative group w-full md:w-48 shrink-0">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                <i class="fa-solid fa-globe text-slate-400 group-hover:text-brand transition-colors"></i>
            </div>
            <select name="filterNormId" asp-items="ViewBag.Norms" onchange="this.form.submit()" 
                    class="appearance-none bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl focus:ring-2 focus:ring-brand/20 focus:border-brand block w-full pl-10 pr-10 py-2.5 transition-all cursor-pointer outline-none hover:border-slate-300 dark:hover:border-[#5a5b60] shadow-sm">
                <option value="">Todas las Normas</option>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none">
                <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors"></i>
            </div>
        </div>

        <div class="relative inline-block text-left shrink-0" id="filterDropdownContainer">
            <button type="button" id="btnFilterToggle" class="w-full md:w-auto h-full inline-flex justify-center items-center gap-2 rounded-xl border border-slate-200 dark:border-[#4a4b50] shadow-sm px-4 py-2.5 bg-white dark:bg-[#323338] text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition-colors focus:outline-none focus:ring-2 focus:ring-brand/20">
                <i class="fa-solid fa-filter text-slate-400"></i> Estado 
                @if(!string.IsNullOrEmpty((string)ViewData["CurrentStatus"]))
                {
                    <span class="ml-1 bg-brand text-white text-[10px] px-2 py-0.5 rounded-full shadow-sm">1</span>
                }
                <i class="fa-solid fa-chevron-down text-[10px] ml-1"></i>
            </button>

            <div id="filterMenu" class="hidden absolute right-0 sm:right-0 mt-2 w-64 rounded-2xl shadow-xl bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] z-50 p-4 transform origin-top-right transition-all">
                <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">Filtrar por Estado</span>
                <div class="flex flex-wrap gap-2">
                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @(string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Todos
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="Active" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Active" ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Solo Activos
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="Inactive" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Inactive" ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Solo Inactivos
                        </div>
                    </label>
                </div>
            </div>
        </div>

        @if(!string.IsNullOrEmpty((string)ViewData["CurrentSearch"]) || !string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) || ViewBag.CurrentFilter != null)
        {
            <a href="/admin/DocumentCategories/Index" class="shrink-0 bg-slate-100 hover:bg-red-50 dark:bg-[#323338] dark:hover:bg-red-500/10 text-slate-500 hover:text-red-500 dark:text-slate-400 px-4 py-2.5 rounded-xl font-bold shadow-sm transition-colors flex items-center justify-center border border-slate-200 dark:border-[#4a4b50]" title="Limpiar filtros">
                <i class="fa-solid fa-xmark"></i>
            </a>
        }
    </form>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 p-4 rounded-r-xl shadow-sm border border-y-red-100 border-r-red-100 dark:border-transparent transition-colors duration-300">
            <div class="flex items-center">
                <i class="fa-solid fa-triangle-exclamation text-red-500 text-lg mr-3"></i>
                <p class="text-sm text-red-700 dark:text-red-400 font-bold">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    }

    <div class="bg-white dark:bg-[#323338] rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] overflow-hidden transition-colors duration-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 dark:bg-[#2a2b2e] text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider transition-colors duration-300">
                    <tr>
                        <th class="p-4 font-semibold">Prefijo</th>
                        <th class="p-4 font-semibold">Categoría</th>
                        <th class="p-4 font-semibold">Norma Aplicable</th>
                        <th class="p-4 font-semibold text-center">Nivel</th>
                        <th class="p-4 font-semibold text-center">Retención</th> 
                        <th class="p-4 font-semibold">Estado</th>
                        <th class="p-4 font-semibold text-center">Acciones</th>
                    </tr>
                </thead>
                 
                <tbody class="divide-y divide-slate-100 dark:divide-[#4a4b50] text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="w-16 h-16 bg-slate-50 dark:bg-[#2a2b2e] rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-100 dark:border-[#4a4b50]">
                                    <i class="fa-solid fa-folder-open text-2xl text-slate-300 dark:text-slate-600"></i>
                                </div>
                                <h5 class="text-lg font-bold text-slate-700 dark:text-slate-300 mb-1">Estructura Vacía</h5>
                                <p class="text-sm">No se encontraron categorías con los filtros actuales.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition duration-150">
                                <td class="p-4 font-mono font-black text-brand dark:text-brand-light">
                                    <span class="bg-brand/5 dark:bg-brand/20 px-3 py-1 rounded-lg border border-brand/10 dark:border-brand/30">
                                        @item.Prefix-
                                    </span>
                                </td>
                                
                                <td class="p-4 font-bold text-slate-800 dark:text-white">
                                    @item.CategoryName
                                </td>

                                <td class="p-4">
                                    @if(item.Norm != null)
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-indigo-700 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800/30 rounded-full px-2.5 py-1">
                                            <i class="fa-solid fa-book-bookmark mr-1.5"></i> @item.Norm.NormName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-[#2a2b2e] border border-slate-200 dark:border-[#4a4b50] rounded-full px-2.5 py-1">
                                            <i class="fa-solid fa-globe mr-1.5"></i> Universal
                                        </span>
                                    }
                                </td>

                                <td class="p-4 text-center">
                                    <span class="inline-flex items-center px-3 py-1 rounded-lg bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800/30 font-bold text-xs">
                                        @item.HierarchyLevel
                                    </span>
                                </td>

                                <td class="p-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-[#4a4b50] font-bold text-xs" title="Se conserva @item.RetentionYears años después de obsoleto">
                                        <i class="fa-solid fa-box-archive mr-1.5 text-slate-400"></i> @item.RetentionYears años
                                    </span>
                                </td>
                                
                                <td class="p-4">
                                    @if (item.Status == "Active")
                                    {
                                        <span class="inline-flex items-center bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 px-2.5 py-1 rounded-full text-xs font-bold border border-green-200 dark:border-green-800/30 w-max">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 px-2.5 py-1 rounded-full text-xs font-bold border border-red-200 dark:border-red-800/30 w-max">
                                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span> Inactivo
                                        </span>
                                    }
                                </td>
                                
                                <td class="p-4 text-center flex justify-center items-center space-x-4">
                                    <a href="/admin/DocumentCategories/Details/@item.CategoryId" asp-route-id="@item.CategoryId" class="text-slate-400 hover:text-brand dark:hover:text-brand transition" title="Ver Detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (item.Status == "Active")
                                    {
                                        <a href="/admin/DocumentCategories/Edit/@item.CategoryId" class="text-slate-400 hover:text-amber-500 transition" title="Editar Categoría">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form action="/admin/DocumentCategories/Delete/@item.CategoryId" method="post" class="inline-block m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-slate-400 hover:text-red-500 transition bg-transparent border-none p-0 cursor-pointer" title="Desactivar" onclick="return confirm('¿Estás seguro de desactivar esta categoría?');">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form action="/admin/DocumentCategories/Reactivate/@item.CategoryId" method="post" class="inline-block m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-slate-400 hover:text-green-500 transition bg-transparent border-none p-0 cursor-pointer" title="Reactivar" onclick="return confirm('¿Deseas volver a activar esta categoría?');">
                                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <div class="bg-slate-50 dark:bg-[#2a2b2e] px-4 py-4 border-t border-slate-200 dark:border-[#4a4b50] flex flex-col sm:flex-row items-center justify-between transition-colors duration-300">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-4 sm:mb-0">
                Mostrando página <span class="font-bold text-slate-800 dark:text-white">@Model.PageIndex</span> de <span class="font-bold text-slate-800 dark:text-white">@Model.TotalPages</span>
                @if(ViewBag.CurrentFilter != null)
                {
                    <span class="ml-1 bg-brand/10 text-brand px-2 py-0.5 rounded text-xs">Con filtros aplicados</span>
                }
            </div>
            
            <div class="flex space-x-2">
                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex - 1)" 
                   asp-route-filterNormId="@ViewBag.CurrentFilter"
                   asp-route-search="@ViewData["CurrentSearch"]"
                   asp-route-status="@ViewData["CurrentStatus"]"
                   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
                   @(Model.HasPreviousPage 
                        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
                        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
                    <i class="fa-solid fa-chevron-left mr-1"></i> Anterior
                </a>

                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex + 1)" 
                   asp-route-filterNormId="@ViewBag.CurrentFilter"
                   asp-route-search="@ViewData["CurrentSearch"]"
                   asp-route-status="@ViewData["CurrentStatus"]"
                   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
                   @(Model.HasNextPage 
                        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
                        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
                    Siguiente <i class="fa-solid fa-chevron-right ml-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnFilterToggle = document.getElementById('btnFilterToggle');
            const filterMenu = document.getElementById('filterMenu');

            if(btnFilterToggle && filterMenu) {
                // Abrir/Cerrar menú
                btnFilterToggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    filterMenu.classList.toggle('hidden');
                });

                // Cerrar al dar click afuera
                document.addEventListener('click', (e) => {
                    if (!filterMenu.contains(e.target) && !btnFilterToggle.contains(e.target)) {
                        filterMenu.classList.add('hidden');
                    }
                });

                // Prevenir que se cierre al dar click adentro
                filterMenu.addEventListener('click', (e) => e.stopPropagation());
            }
        });
    </script>
}