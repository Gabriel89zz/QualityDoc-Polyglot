@model QualityDoc.API.Models.Document

@{
    ViewData["Title"] = "Crear Documento";
}

<div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6 mt-4">
    
    <nav class="flex mb-4 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider">
        <ol class="inline-flex items-center space-x-2">
            <li><a href="/admin/Documents/Index" class="hover:text-brand transition-colors">Documentos</a></li>
            <li><i class="fa-solid fa-chevron-right text-[10px]"></i></li>
            <li class="text-slate-400 dark:text-slate-500">Nuevo</li>
        </ol>
    </nav>

    <div class="bg-white dark:bg-[#323338] rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] overflow-hidden transition-colors duration-300">
        
        <div class="bg-brand/5 dark:bg-brand/10 border-b border-brand/10 dark:border-brand/20 p-6 flex items-center">
            <div class="bg-brand text-white h-12 w-12 flex items-center justify-center rounded-xl text-xl mr-4 shadow-sm shadow-brand/20">
                <i class="fa-solid fa-file-circle-plus"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-brand dark:text-brand-light">Alta de Nuevo Documento</h2>
                <p class="text-sm text-slate-600 dark:text-slate-400">Registra y clasifica la información documentada.</p>
            </div>
        </div>
        
        <div class="p-6 lg:p-10">
            <form action="/admin/Documents/Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-6 text-sm font-semibold bg-red-50 dark:bg-red-900/20 p-3 rounded-xl border border-red-100 dark:border-transparent"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
                    
                    <div class="lg:col-span-5 lg:border-r border-slate-100 dark:border-[#4a4b50] lg:pr-10 transition-colors duration-300">
                        <h5 class="text-slate-400 dark:text-slate-500 font-bold border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5 uppercase text-xs tracking-widest">Clasificación</h5>
                        
                        <div class="mb-6">
                            <label for="NormFilter" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Normativa (Filtro) <span class="text-brand text-xs ml-1 font-medium">(Opcional)</span></label>
                            <div class="relative">
                                <select id="NormFilter" class="w-full pl-4 pr-10 rounded-xl bg-slate-50 dark:bg-[#2a2b2e]/50 border border-slate-300 dark:border-[#4a4b50] py-2.5 text-slate-700 dark:text-white focus:border-brand dark:focus:border-brand focus:ring-2 focus:ring-brand/20 transition outline-none appearance-none" asp-items="ViewBag.Norms">
                                    <option value="">-- Todas las Categorías --</option>
                                    <option value="0">General / Sin Normativa Asignada</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-filter text-xs"></i>
                                </div>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label asp-for="CategoryId" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Categoría <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <select asp-for="CategoryId" id="CategorySelect" class="w-full pl-4 pr-10 rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] py-2.5 text-slate-700 dark:text-white focus:border-brand dark:focus:border-brand focus:ring-2 focus:ring-brand/20 transition outline-none appearance-none disabled:opacity-50 disabled:bg-slate-100 dark:disabled:bg-[#323338]" required>
                                    <option value="">-- Seleccione una Categoría --</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                </div>
                            </div>
                            <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                        </div>

                        @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
                        {
                            <div class="mb-6">
                                <label asp-for="DeptId" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Departamento Dueño <span class="text-red-500">*</span></label>
                                <div class="relative">
                                    <select asp-for="DeptId" class="w-full pl-4 pr-10 rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] py-2.5 text-slate-700 dark:text-white focus:border-brand dark:focus:border-brand focus:ring-2 focus:ring-brand/20 transition outline-none appearance-none" asp-items="ViewBag.Departments" required>
                                        <option value="">-- Seleccione un Departamento --</option>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </div>
                                </div>
                                <span asp-validation-for="DeptId" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-6">
                                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Departamento Dueño</label>
                                <div class="w-full rounded-xl bg-slate-50 dark:bg-[#2a2b2e]/50 border border-slate-200 dark:border-[#4a4b50] px-4 py-2.5 text-slate-500 dark:text-slate-400 flex items-center shadow-inner cursor-not-allowed">
                                    <i class="fa-solid fa-lock text-slate-400 mr-3 text-xs"></i>
                                    <span class="text-sm font-medium">Asignación automática a tu departamento</span>
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1.5"><i class="fa-solid fa-circle-info mr-1"></i> Por seguridad, el documento se vinculará a tu área operativa.</p>
                            </div>
                        }

                        <h5 class="text-slate-400 dark:text-slate-500 font-bold border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5 mt-10 uppercase text-xs tracking-widest">Detalles</h5>

                        <div class="mb-6">
                            <label asp-for="DocName" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Título del Documento <span class="text-red-500">*</span></label>
                            <input asp-for="DocName" class="w-full rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] px-4 py-2.5 text-slate-700 dark:text-white placeholder-slate-400 focus:border-brand dark:focus:border-brand focus:ring-2 focus:ring-brand/20 transition outline-none" placeholder="Ej. Procedimiento de Auditoría Interna" required autocomplete="off" />
                            <span asp-validation-for="DocName" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                        </div>

                        <div class="mb-6">
                            <label asp-for="Description" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Descripción / Objetivo</label>
                            <textarea asp-for="Description" rows="4" class="w-full rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] px-4 py-2.5 text-slate-700 dark:text-white placeholder-slate-400 focus:border-brand dark:focus:border-brand focus:ring-2 focus:ring-brand/20 transition outline-none resize-none" placeholder="Breve descripción del propósito del documento..."></textarea>
                            <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                        </div>
                        
                        <div class="mt-4 flex items-start group">
                            <div class="flex items-center h-5">
                                <input asp-for="IsExternal" type="checkbox" class="w-5 h-5 rounded border-slate-300 dark:border-slate-500 text-brand focus:ring-brand dark:bg-[#2a2b2e] transition-colors duration-300 cursor-pointer">
                            </div>
                            <div class="ml-3 text-sm">
                                <label asp-for="IsExternal" class="font-bold text-slate-700 dark:text-slate-300 cursor-pointer group-hover:text-brand transition-colors">Documento de origen externo</label>
                                <p class="text-slate-500 dark:text-slate-400 mt-0.5">Ej. Manual de proveedor, Norma de cliente.</p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-7 flex flex-col h-full">
                        <div class="flex justify-between items-center border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5">
                            <h5 class="text-slate-400 dark:text-slate-500 font-bold uppercase text-xs tracking-widest">Archivo (Versión 1.0)</h5>
                        </div>
                        
                        <div id="uploadContainer" class="bg-slate-50 dark:bg-[#2a2b2e] border-2 border-dashed border-slate-300 dark:border-[#4a4b50] rounded-2xl p-6 text-center transition duration-300 ease-in-out relative min-h-[650px] flex flex-col justify-center">
                            
                            <div id="uploadPrompt" class="transition-opacity duration-300">
                                <div class="w-20 h-20 bg-white dark:bg-[#323338] rounded-full flex items-center justify-center mx-auto mb-5 shadow-sm border border-slate-100 dark:border-transparent">
                                    <i class="fa-solid fa-cloud-arrow-up text-3xl text-brand/60"></i>
                                </div>
                                <label for="uploadedFile" class="block text-base font-bold text-slate-700 dark:text-slate-300 mb-2 cursor-pointer hover:text-brand transition-colors">Seleccionar Archivo <span class="text-red-500">*</span></label>
                                
                                <input type="file" name="uploadedFile" id="uploadedFile" class="hidden" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.zip,.rar,.png,.jpg,.jpeg" required />
                                
                                <button type="button" onclick="document.getElementById('uploadedFile').click();"
                                        class="mt-4 bg-brand/10 text-brand hover:bg-brand/20 dark:bg-brand/20 dark:text-brand-light font-bold py-2.5 px-6 rounded-xl text-sm transition shadow-sm">
                                    Explorar Archivos
                                </button>
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-5 font-medium">PDF, Word, Excel, PPT, ZIP o Imágenes. Máx: 25MB.</p>
                            </div>

                            <div id="previewContainer" class="hidden w-full h-full flex flex-col absolute inset-0 p-4">
                                <div class="flex justify-between items-center mb-3">
                                    <h6 class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/20 px-3 py-1.5 rounded-md border border-emerald-200 dark:border-emerald-800/30 shadow-sm">
                                        <i class="fa-solid fa-circle-check mr-1.5"></i> Archivo Listo
                                    </h6>
                                    <button type="button" onclick="removeFile()" class="text-red-500 hover:text-white hover:bg-red-500 bg-red-50 dark:bg-red-900/20 px-3 py-1.5 rounded-lg transition-colors shadow-sm text-xs font-bold flex items-center" title="Quitar archivo">
                                        <i class="fa-solid fa-trash-can mr-1.5"></i> Quitar
                                    </button>
                                </div>
                                
                                <div id="filePreview" class="w-full flex-grow bg-slate-200 dark:bg-[#1a1b1e] rounded-xl overflow-hidden border border-slate-300 dark:border-[#4a4b50] flex items-center justify-center relative shadow-inner">
                                    </div>

                                <div class="mt-3 flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] p-3 rounded-lg shadow-sm">
                                    <span id="fileNameDisplay" class="truncate max-w-[200px] lg:max-w-[400px] text-slate-700 dark:text-slate-200"></span>
                                    <span id="fileSizeDisplay" class="bg-slate-100 dark:bg-[#2a2b2e] px-2.5 py-1 rounded-md border border-slate-200 dark:border-[#4a4b50]"></span>
                                </div>
                            </div>

                            @if (ViewData.ModelState["uploadedFile"]?.Errors.Count > 0)
                            {
                                <span class="text-red-500 text-sm font-bold block mt-3 absolute bottom-2 left-0 w-full text-center bg-white/80 dark:bg-[#323338]/80 py-1">@ViewData.ModelState["uploadedFile"]?.Errors[0].ErrorMessage</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-10 pt-6 border-t border-slate-100 dark:border-[#4a4b50] flex justify-end space-x-3 transition-colors duration-300">
                    <a href="/admin/Documents/Index" class="bg-slate-100 dark:bg-[#2a2b2e] hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-bold py-3 px-6 rounded-xl transition duration-150">
                        Cancelar y Volver
                    </a>
                    <button type="submit" class="bg-brand hover:bg-brand-hover text-white text-sm font-bold py-3 px-8 rounded-xl shadow-md shadow-brand/20 flex items-center transition duration-150">
                        <i class="fa-solid fa-floppy-disk mr-2"></i> Guardar Documento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // ==========================================
            // LÓGICA DE CASCADA DE CATEGORÍAS
            // ==========================================
            const categoriasData = @Html.Raw(ViewBag.CategoriasJson ?? "[]");
            const normFilter = document.getElementById('NormFilter');
            const categorySelect = document.getElementById('CategorySelect');
            const selectedCategoryId = '@(Model?.CategoryId ?? 0)';

            function renderCategories() {
                const selectedNorm = normFilter.value;
                categorySelect.innerHTML = '<option value="">-- Seleccione una Categoría --</option>';
                
                let filtered = categoriasData;
                
                if (selectedNorm !== "") {
                    filtered = categoriasData.filter(c => c.NormId.toString() === selectedNorm);
                }

                if(filtered.length === 0) {
                    categorySelect.innerHTML = '<option value="">No hay categorías para esta norma</option>';
                    categorySelect.disabled = true;
                    return;
                }

                categorySelect.disabled = false;
                filtered.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.CategoryId;
                    option.textContent = c.CategoryName;
                    categorySelect.appendChild(option);
                });
            }

            if (normFilter && categorySelect) {
                normFilter.addEventListener('change', renderCategories);

                if (selectedCategoryId !== '0') {
                    const cat = categoriasData.find(c => c.CategoryId.toString() === selectedCategoryId);
                    if (cat) {
                        normFilter.value = cat.NormId; 
                    }
                }
                
                renderCategories(); 
                
                if (selectedCategoryId !== '0') {
                    categorySelect.value = selectedCategoryId; 
                }
            }

            // ==========================================
            // LÓGICA DE VISTA PREVIA DEL DOCUMENTO
            // ==========================================
            const fileInput = document.getElementById('uploadedFile');
            const uploadPrompt = document.getElementById('uploadPrompt');
            const previewContainer = document.getElementById('previewContainer');
            const filePreview = document.getElementById('filePreview');
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            const fileSizeDisplay = document.getElementById('fileSizeDisplay');
            let currentObjectUrl = null;

            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        // ==========================================
                        // 🚀 1. RESTRICCIÓN DE PESO REAL (25 MB)
                        // ==========================================
                        const maxSizeInMB = 25;
                        const maxSizeInBytes = maxSizeInMB * 1024 * 1024;
                        
                        if (file.size > maxSizeInBytes) {
                            alert(`El archivo "${file.name}" es demasiado grande.\n\nEl tamaño actual es de ${(file.size / (1024 * 1024)).toFixed(2)} MB.\nEl límite máximo permitido es de ${maxSizeInMB} MB.`);
                            this.value = ''; // Vacía el input
                            return; // Detiene la ejecución
                        }

                        fileNameDisplay.textContent = file.name;
                        fileSizeDisplay.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

                        uploadPrompt.classList.add('hidden');
                        previewContainer.classList.remove('hidden');

                        if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);

                        if (file.type === 'application/pdf') {
                            currentObjectUrl = URL.createObjectURL(file);
                            filePreview.innerHTML = `<iframe src="${currentObjectUrl}#toolbar=0&navpanes=0" class="absolute inset-0 w-full h-full border-0"></iframe>`;
                        } 
                        else if (file.type.startsWith('image/')) {
                            currentObjectUrl = URL.createObjectURL(file);
                            filePreview.innerHTML = `<img src="${currentObjectUrl}" class="absolute inset-0 w-full h-full object-contain bg-slate-100 dark:bg-[#2a2b2e] p-2" alt="Vista previa" />`;
                        } 
                        else {
                            // 🚀 2. LÓGICA DE ÍCONOS PARA LOS NUEVOS ARCHIVOS
                            let iconClass = 'fa-file-lines text-slate-400';
                            let fileTypeName = 'Documento';
                            const ext = file.name.toLowerCase();

                            if(ext.endsWith('.doc') || ext.endsWith('.docx')) {
                                iconClass = 'fa-file-word text-[#1a73e8]'; fileTypeName = 'Word';
                            } else if(ext.endsWith('.xls') || ext.endsWith('.xlsx')) {
                                iconClass = 'fa-file-excel text-[#188038]'; fileTypeName = 'Excel';
                            } else if(ext.endsWith('.ppt') || ext.endsWith('.pptx')) {
                                iconClass = 'fa-file-powerpoint text-[#d93025]'; fileTypeName = 'PowerPoint';
                            } else if(ext.endsWith('.csv')) {
                                iconClass = 'fa-file-csv text-emerald-600'; fileTypeName = 'Datos (CSV)';
                            } else if(ext.endsWith('.zip') || ext.endsWith('.rar')) {
                                iconClass = 'fa-file-zipper text-slate-500'; fileTypeName = 'Comprimido';
                            }
                            
                            filePreview.innerHTML = `
                                <div class="absolute inset-0 w-full h-full bg-white dark:bg-[#323338] text-center p-6 flex flex-col items-center justify-center">
                                    <i class="fa-solid ${iconClass} text-6xl mb-4 opacity-90 drop-shadow-sm"></i>
                                    <p class="text-sm font-bold text-slate-700 dark:text-slate-200">Archivo de ${fileTypeName} Listo</p>
                                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-2 px-4">
                                        El archivo se ha adjuntado con éxito y está listo para ser guardado.
                                    </p>
                                </div>
                            `;
                        }
                    }
                });
            }

            window.removeFile = function() {
                fileInput.value = ''; 
                uploadPrompt.classList.remove('hidden'); 
                previewContainer.classList.add('hidden'); 
                filePreview.innerHTML = ''; 
                if (currentObjectUrl) {
                    URL.revokeObjectURL(currentObjectUrl);
                    currentObjectUrl = null;
                }
            };
        });
    </script>
}