@using QualityDoc.API.Helpers
@model PaginatedList<QualityDoc.API.Models.Document>

@{
    ViewData["Title"] = "Catálogo de Documentos";
    
    // 🧠 Lógica de Permisos Visuales
    bool isAdmin = User.IsInRole("Admin de Empresa");
    bool isCreator = User.IsInRole("Creador de Doc");
    int myDeptId = ViewBag.UserDeptId ?? 0;
    
    // 🧠 Diccionarios de trazabilidad (Enviados desde el Backend)
    var latestStatuses = ViewBag.LatestStatuses as Dictionary<int, int>;
    var hasAdvancedVersions = ViewBag.HasAdvancedVersions as List<int>;
}

<div class="w-full max-w-7xl mx-auto space-y-6">
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white dark:bg-[#323338] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] transition-colors duration-300 mb-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center">
                <div class="w-10 h-10 rounded-xl bg-brand/10 flex items-center justify-center mr-3 border border-brand/20">
                    <i class="fa-solid fa-folder-open text-brand"></i>
                </div>
                Documentos Maestros
            </h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Gestión y control de la información documentada (ISO 9001)</p>
        </div>
        <div class="mt-4 sm:mt-0">
            @if (isAdmin || isCreator)
            {
                <a href="/admin/Documents/Create" class="bg-brand hover:bg-brand-hover text-white font-bold py-2.5 px-5 rounded-xl shadow-md shadow-brand/20 flex items-center transition duration-200">
                    <i class="fa-solid fa-plus mr-2"></i> Nuevo Documento
                </a>
            }
        </div>
    </div>

    <form method="get" action="/admin/Documents/Index" id="searchForm" class="flex flex-col lg:flex-row gap-3 mb-6 relative z-40 animate-fade-up">
        
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </span>
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" autocomplete="off" placeholder="Buscar por folio o título..." 
                   class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] rounded-xl text-sm focus:outline-none focus:border-brand dark:focus:border-brand shadow-sm transition-all text-slate-700 dark:text-slate-200" />
        </div>

        @if (ViewBag.IsAdmin == true)
        {
            <div class="relative group w-full lg:w-48 shrink-0">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                    <i class="fa-solid fa-users-rectangle text-slate-400 group-hover:text-brand transition-colors"></i>
                </div>
                <select name="deptId" asp-items="ViewBag.Departments" onchange="this.form.submit()" 
                        class="appearance-none bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl focus:ring-2 focus:ring-brand/20 focus:border-brand block w-full pl-10 pr-10 py-2.5 transition-all cursor-pointer outline-none hover:border-slate-300 dark:hover:border-[#5a5b60] shadow-sm">
                    <option value="">Todos los Deptos</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none">
                    <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors"></i>
                </div>
            </div>
        }

        <div class="relative group w-full lg:w-56 shrink-0">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none">
                <i class="fa-solid fa-folder-tree text-slate-400 group-hover:text-brand transition-colors"></i>
            </div>
            <select name="categoryId" asp-items="ViewBag.Categories" onchange="this.form.submit()" 
                    class="appearance-none bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl focus:ring-2 focus:ring-brand/20 focus:border-brand block w-full pl-10 pr-10 py-2.5 transition-all cursor-pointer outline-none hover:border-slate-300 dark:hover:border-[#5a5b60] shadow-sm">
                <option value="">Todas las Categorías</option>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none">
                <i class="fa-solid fa-chevron-down text-slate-400 text-[10px] group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors"></i>
            </div>
        </div>

        <div class="relative inline-block text-left shrink-0" id="filterDropdownContainer">
            <button type="button" id="btnFilterToggle" class="w-full md:w-auto h-full inline-flex justify-center items-center gap-2 rounded-xl border border-slate-200 dark:border-[#4a4b50] shadow-sm px-4 py-2.5 bg-white dark:bg-[#323338] text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition-colors focus:outline-none focus:ring-2 focus:ring-brand/20">
                <i class="fa-solid fa-sliders text-slate-400"></i> Filtros 
                @if(!string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) || !string.IsNullOrEmpty((string)ViewData["CurrentOrigin"]))
                {
                    <span class="ml-1 bg-brand text-white text-[10px] px-2 py-0.5 rounded-full shadow-sm">
                        @( (string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) ? 0 : 1) + (string.IsNullOrEmpty((string)ViewData["CurrentOrigin"]) ? 0 : 1) )
                    </span>
                }
                <i class="fa-solid fa-chevron-down text-[10px] ml-1"></i>
            </button>

            <div id="filterMenu" class="hidden absolute right-0 sm:right-0 mt-2 w-72 rounded-2xl shadow-xl bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] z-50 p-5 transform origin-top-right transition-all">
                
                <div class="mb-4 pb-4 border-b border-slate-100 dark:border-[#4a4b50]">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">Origen del Documento</span>
                    <div class="flex flex-wrap gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="origin" value="" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @(string.IsNullOrEmpty((string)ViewData["CurrentOrigin"]) ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Todos</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="origin" value="Interno" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentOrigin"] == "Interno" ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Internos</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="origin" value="Externo" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentOrigin"] == "Externo" ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Externos</div>
                        </label>
                    </div>
                </div>

                <div>
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">Estado</span>
                    <div class="flex flex-wrap gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="status" value="" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @(string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Todos</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="status" value="Active" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Active" ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Vigentes</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="status" value="Inactive" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Inactive" ? "checked" : "")>
                            <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">Suspendidos</div>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        @if(!string.IsNullOrEmpty((string)ViewData["CurrentSearch"]) || !string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) || !string.IsNullOrEmpty((string)ViewData["CurrentOrigin"]) || ViewBag.CurrentCategory != null || ViewBag.CurrentDept != null)
        {
            <a href="/admin/Documents/Index" class="shrink-0 bg-slate-100 hover:bg-red-50 dark:bg-[#323338] dark:hover:bg-red-500/10 text-slate-500 hover:text-red-500 dark:text-slate-400 px-4 py-2.5 rounded-xl font-bold shadow-sm transition-colors flex items-center justify-center border border-slate-200 dark:border-[#4a4b50]" title="Limpiar filtros">
                <i class="fa-solid fa-xmark"></i>
            </a>
        }
    </form>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 p-4 rounded-r-xl shadow-sm border border-y-red-100 border-r-red-100 dark:border-transparent transition-colors duration-300">
            <span class="block sm:inline text-red-700 dark:text-red-400 text-sm font-bold">
                <i class="fa-solid fa-triangle-exclamation mr-1"></i> @TempData["ErrorMessage"]
            </span>
        </div>
    }

    <div class="bg-white dark:bg-[#323338] rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] overflow-hidden transition-colors duration-300">
        <div class="overflow-x-auto">
            <table class="min-w-full text-left border-collapse">
                <thead class="bg-slate-50 dark:bg-[#2a2b2e] text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider transition-colors duration-300">
                    <tr>
                        <th scope="col" class="p-4 font-semibold">Folio</th>
                        <th scope="col" class="p-4 font-semibold">Título del Documento</th>
                        <th scope="col" class="p-4 font-semibold">Categoría</th>
                        <th scope="col" class="p-4 font-semibold">Departamento</th>
                        <th scope="col" class="p-4 font-semibold">Origen</th>
                        <th scope="col" class="p-4 font-semibold">Estatus</th>
                        <th scope="col" class="p-4 font-semibold text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-[#4a4b50] text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-10 text-center text-slate-500 dark:text-slate-400">
                                <i class="fa-regular fa-folder-open text-4xl mb-3 text-slate-300 dark:text-slate-600 block"></i>
                                <h5 class="text-lg font-bold text-slate-700 dark:text-slate-300 mb-1">No hay documentos registrados</h5>
                                <p class="text-sm">Comienza a organizar tu control documental.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            // 🧠 BLINDAJE: Analizando si es seguro editar/borrar este renglón
                            int latestStatus = latestStatuses != null && latestStatuses.ContainsKey(item.DocId) ? latestStatuses[item.DocId] : 1;
                            bool canEdit = latestStatus == 1; // Solo se edita si está en Borrador
                            bool canDelete = hasAdvancedVersions != null && !hasAdvancedVersions.Contains(item.DocId); // Solo se borra si NUNCA ha avanzado

                            // 🧠 VISUALES: Evaluando qué botones pintar
                            bool showPen = (isAdmin || (isCreator && item.DeptId == myDeptId)) && canEdit;
                            bool showTrash = isAdmin && canDelete && item.Status == "Active";
                            bool showReactivate = isAdmin && item.Status != "Active";
                            bool hasMoreButtons = showPen || showTrash || showReactivate;
                            string eyeRadiusClass = hasMoreButtons ? "rounded-l-lg" : "rounded-lg";

                            <tr class="hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition duration-150">
                                <td class="p-4 whitespace-nowrap text-sm font-bold text-brand dark:text-brand-light">
                                    @item.DocCode
                                </td>
                                <td class="p-4 text-sm font-bold text-slate-800 dark:text-white">
                                    @item.DocName
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <span class="ml-1 text-slate-400 dark:text-slate-500 cursor-help" title="@item.Description">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </span>
                                    }
                                </td>
                                <td class="p-4 whitespace-nowrap text-sm">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-700 dark:text-slate-300 text-xs font-semibold shadow-sm">
                                        @item.Category?.CategoryName
                                    </span>
                                </td>
                                <td class="p-4 whitespace-nowrap text-sm text-slate-700 dark:text-slate-300 font-medium">
                                    @item.Department?.DeptName
                                </td>
                                <td class="p-4 whitespace-nowrap text-sm">
                                    @if (item.IsExternal)
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-purple-700 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800/30 rounded-full px-2.5 py-1">
                                            <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i> Externo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-teal-700 dark:text-teal-400 bg-teal-50 dark:bg-teal-900/20 border border-teal-200 dark:border-teal-800/30 rounded-full px-2.5 py-1">
                                            <i class="fa-solid fa-building-user mr-1"></i> Interno
                                        </span>
                                    }
                                </td>
                                <td class="p-4 whitespace-nowrap text-sm">
                                    @switch (latestStatus)
                                    {
                                        case 1: // Borrador
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-[#323338] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-[#4a4b50] shadow-sm">
                                                <i class="fa-solid fa-file-pen mr-1.5"></i> Borrador
                                            </span>
                                            break;
                                        case 2: // En revisión
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/30 shadow-sm animate-pulse">
                                                <i class="fa-solid fa-clock-rotate-left mr-1.5"></i> En Revisión
                                            </span>
                                            break;
                                        case 3: // Aprobado
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/30 shadow-sm">
                                                <i class="fa-solid fa-check-double mr-1.5"></i> Aprobado
                                            </span>
                                            break;
                                        case 4: // Obsoleto
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800/30 shadow-sm">
                                                <i class="fa-solid fa-ban mr-1.5"></i> Obsoleto
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-[#323338] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-[#4a4b50] shadow-sm">
                                                <i class="fa-solid fa-circle-question mr-1.5"></i> Desconocido
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="p-4 whitespace-nowrap text-center text-sm font-medium">
                                    
                                    <div class="inline-flex shadow-sm rounded-lg" role="group">
                                        
                                        <a href="/admin/Documents/Details/@item.DocId" class="inline-flex items-center px-3 py-1.5 border border-slate-200 dark:border-[#4a4b50] bg-white dark:bg-[#2a2b2e] text-slate-400 hover:bg-slate-50 dark:hover:bg-[#323338] @eyeRadiusClass hover:text-brand dark:hover:text-brand-light transition-colors" title="Ver Detalles">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        
                                        @if (showPen)
                                        {
                                            bool isLast = !showTrash && !showReactivate;
                                            string penBorderClass = isLast ? "border border-l-0 border-slate-200 dark:border-[#4a4b50] rounded-r-lg" : "border-t border-b border-slate-200 dark:border-[#4a4b50]";

                                            <a href="/admin/Documents/Edit/@item.DocId" class="inline-flex items-center px-3 py-1.5 bg-white dark:bg-[#2a2b2e] text-slate-400 hover:bg-slate-50 dark:hover:bg-[#323338] hover:text-amber-500 transition-colors @penBorderClass" title="Editar Documento">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }

                                        @if (showTrash)
                                        {
                                            <form action="/admin/Documents/Delete/@item.DocId" method="post" class="inline-block m-0" onsubmit="return confirm('¿Estás seguro de suspender este documento? Pasará a estado inactivo.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-l-0 border-slate-200 dark:border-[#4a4b50] bg-white dark:bg-[#2a2b2e] text-slate-400 hover:bg-slate-50 dark:hover:bg-[#323338] rounded-r-lg hover:text-red-500 transition-colors" title="Suspender (Solo permitido en fase de Borrador)">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        }
                                        
                                        @if (showReactivate)
                                        {
                                            <form action="/admin/Documents/Reactivate/@item.DocId" method="post" class="inline-block m-0" onsubmit="return confirm('¿Deseas reactivar este documento al sistema?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-l-0 border-slate-200 dark:border-[#4a4b50] bg-white dark:bg-[#2a2b2e] text-slate-400 hover:bg-slate-50 dark:hover:bg-[#323338] rounded-r-lg hover:text-green-500 transition-colors" title="Reactivar">
                                                    <i class="fa-solid fa-rotate-left"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <div class="bg-slate-50 dark:bg-[#2a2b2e] px-4 py-4 border-t border-slate-200 dark:border-[#4a4b50] flex flex-col sm:flex-row items-center justify-between transition-colors duration-300">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-4 sm:mb-0">
                Mostrando página <span class="font-bold text-slate-800 dark:text-white">@Model.PageIndex</span> de <span class="font-bold text-slate-800 dark:text-white">@Model.TotalPages</span>
            </div>
            
            <div class="flex space-x-2">
                <a href="/admin/Documents/Index?pageNumber=@(Model.PageIndex - 1)&search=@ViewData["CurrentSearch"]&status=@ViewData["CurrentStatus"]&origin=@ViewData["CurrentOrigin"]&categoryId=@ViewBag.CurrentCategory&deptId=@ViewBag.CurrentDept"
   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
   @(Model.HasPreviousPage 
        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
    <i class="fa-solid fa-chevron-left mr-1"></i> Anterior
</a>

                <a href="/admin/Documents/Index?pageNumber=@(Model.PageIndex + 1)&search=@ViewData["CurrentSearch"]&status=@ViewData["CurrentStatus"]&origin=@ViewData["CurrentOrigin"]&categoryId=@ViewBag.CurrentCategory&deptId=@ViewBag.CurrentDept"
   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
   @(Model.HasNextPage 
        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
    Siguiente <i class="fa-solid fa-chevron-right ml-1"></i>
</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnFilterToggle = document.getElementById('btnFilterToggle');
            const filterMenu = document.getElementById('filterMenu');

            if(btnFilterToggle && filterMenu) {
                // Abrir/Cerrar menú
                btnFilterToggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    filterMenu.classList.toggle('hidden');
                });

                // Cerrar al dar click afuera
                document.addEventListener('click', (e) => {
                    if (!filterMenu.contains(e.target) && !btnFilterToggle.contains(e.target)) {
                        filterMenu.classList.add('hidden');
                    }
                });

                // Prevenir que se cierre al dar click adentro
                filterMenu.addEventListener('click', (e) => e.stopPropagation());
            }
        });
    </script>
}