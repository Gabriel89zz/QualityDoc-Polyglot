@model QualityDoc.API.Models.Document

@{
    ViewData["Title"] = "Editar Documento";
}

<div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6 mt-4">
    <nav class="flex mb-4 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider">
        <ol class="inline-flex items-center space-x-2">
            <li><a href="/admin/Documents/Index" class="hover:text-brand transition-colors">Documentos</a></li>
            <li><i class="fa-solid fa-chevron-right text-[10px]"></i></li>
            <li class="text-slate-400 dark:text-slate-500">Editar Metadatos</li>
        </ol>
    </nav>

    <div class="bg-white dark:bg-[#323338] rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] overflow-hidden transition-colors duration-300">
        
        <div class="bg-amber-50 dark:bg-amber-900/10 border-b border-amber-100 dark:border-amber-900/20 p-6 flex items-center">
            <div class="bg-amber-500 text-white h-12 w-12 flex items-center justify-center rounded-xl text-xl mr-4 shadow-sm shadow-amber-500/20">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-amber-900 dark:text-amber-400">Editar Documento: @Model.DocCode</h2>
                <p class="text-sm text-amber-700 dark:text-amber-500/80">Modifica los detalles o reemplaza el archivo del borrador.</p>
            </div>
        </div>
        
        <div class="p-6 lg:p-10">
            <form action="/admin/Documents/Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-6 text-sm font-semibold bg-red-50 dark:bg-red-900/20 p-3 rounded-xl border border-red-100 dark:border-transparent"></div>
                
                <input type="hidden" asp-for="DocId" />
                <input type="hidden" asp-for="CompanyId" />
                <input type="hidden" asp-for="CategoryId" />
                <input type="hidden" asp-for="DeptId" /> 
                <input type="hidden" asp-for="DocCode" />

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
                    
                    <div class="lg:col-span-5 lg:border-r border-slate-100 dark:border-[#4a4b50] lg:pr-10 transition-colors duration-300">
                        <h5 class="text-slate-400 dark:text-slate-500 font-bold border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5 uppercase text-xs tracking-widest">Clasificación Fija</h5>
                        
                        <div class="mb-6">
                            <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Categoría (No editable)</label>
                            <input type="text" class="w-full rounded-xl bg-slate-50 dark:bg-[#2a2b2e]/50 border border-slate-200 dark:border-[#4a4b50] px-4 py-2.5 text-slate-500 dark:text-slate-400 cursor-not-allowed transition-colors" value="@Model.Category?.CategoryName" disabled />
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Departamento Dueño (No editable)</label>
                            <input type="text" class="w-full rounded-xl bg-slate-50 dark:bg-[#2a2b2e]/50 border border-slate-200 dark:border-[#4a4b50] px-4 py-2.5 text-slate-500 dark:text-slate-400 cursor-not-allowed transition-colors" value="@Model.Department?.DeptName" disabled />
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-2 font-medium"><i class="fa-solid fa-lock text-[10px] mr-1"></i> La categoría y el departamento definen el folio; no se pueden alterar.</p>
                        </div>

                        <h5 class="text-slate-400 dark:text-slate-500 font-bold border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5 mt-10 uppercase text-xs tracking-widest">Detalles Editables</h5>

                        <div class="mb-6">
                            <label asp-for="DocName" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Título del Documento <span class="text-red-500">*</span></label>
                            <input asp-for="DocName" class="w-full rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] px-4 py-2.5 text-slate-700 dark:text-white focus:border-amber-500 dark:focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition outline-none" required />
                            <span asp-validation-for="DocName" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                        </div>

                        <div class="mb-6">
                            <label asp-for="Description" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Descripción / Objetivo</label>
                            <textarea asp-for="Description" rows="4" class="w-full rounded-xl bg-white dark:bg-[#2a2b2e] border border-slate-300 dark:border-[#4a4b50] px-4 py-2.5 text-slate-700 dark:text-white focus:border-amber-500 dark:focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition outline-none resize-none"></textarea>
                            <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block font-semibold"></span>
                        </div>
                        
                        <div class="mt-4 flex items-start group">
                            <div class="flex items-center h-5">
                                <input asp-for="IsExternal" type="checkbox" class="w-5 h-5 rounded border-slate-300 dark:border-slate-500 text-amber-500 focus:ring-amber-500 dark:bg-[#2a2b2e] transition-colors duration-300 cursor-pointer">
                            </div>
                            <div class="ml-3 text-sm">
                                <label asp-for="IsExternal" class="font-bold text-slate-700 dark:text-slate-300 cursor-pointer group-hover:text-amber-600 dark:group-hover:text-amber-500 transition-colors">Documento de origen externo</label>
                                <p class="text-slate-500 dark:text-slate-400 mt-0.5">Ej. Manual de proveedor, Norma de cliente.</p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-7 flex flex-col h-full">
                        <div class="flex justify-between items-center border-b border-slate-100 dark:border-[#4a4b50] pb-2 mb-5">
                            <h5 class="text-slate-400 dark:text-slate-500 font-bold uppercase text-xs tracking-widest">Reemplazar Archivo (Opcional)</h5>
                        </div>
                        
                        <div id="uploadContainer" class="bg-slate-50 dark:bg-[#2a2b2e] border-2 border-dashed border-slate-300 dark:border-[#4a4b50] rounded-2xl p-6 text-center transition duration-300 ease-in-out relative min-h-[650px] flex flex-col justify-center">
                            
                            <div id="uploadPrompt" class="transition-opacity duration-300">
                                <div class="w-20 h-20 bg-white dark:bg-[#323338] rounded-full flex items-center justify-center mx-auto mb-5 shadow-sm border border-slate-100 dark:border-transparent">
                                    <i class="fa-solid fa-file-pdf text-3xl text-amber-500/60"></i>
                                </div>
                                <label for="newFile" class="block text-base font-bold text-slate-700 dark:text-slate-300 mb-2 cursor-pointer hover:text-amber-500 transition-colors">Seleccionar Nuevo Archivo</label>
                                
                                <input type="file" name="newFile" id="newFile" class="hidden" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
                                
                                <button type="button" onclick="document.getElementById('newFile').click();" class="mt-4 bg-amber-50 text-amber-700 hover:bg-amber-100 dark:bg-amber-900/20 dark:text-amber-500 dark:hover:bg-amber-900/40 font-bold py-2.5 px-6 rounded-xl text-sm transition shadow-sm">
                                    Explorar Archivos
                                </button>
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-5 font-medium">Deja este campo vacío si solo quieres corregir metadatos.</p>
                            </div>

                            <div id="previewContainer" class="hidden w-full h-full flex flex-col absolute inset-0 p-4">
                                <div class="flex justify-between items-center mb-3">
                                    <h6 class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/20 px-3 py-1.5 rounded-md border border-emerald-200 dark:border-emerald-800/30 shadow-sm">
                                        <i class="fa-solid fa-circle-check mr-1.5"></i> Nuevo Archivo Listo
                                    </h6>
                                    <button type="button" onclick="removeFile()" class="text-red-500 hover:text-white hover:bg-red-500 bg-red-50 dark:bg-red-900/20 px-3 py-1.5 rounded-lg transition-colors shadow-sm text-xs font-bold flex items-center" title="Quitar archivo">
                                        <i class="fa-solid fa-trash-can mr-1.5"></i> Quitar
                                    </button>
                                </div>
                                
                                <div id="filePreview" class="w-full flex-grow bg-slate-200 dark:bg-[#1a1b1e] rounded-xl overflow-hidden border border-slate-300 dark:border-[#4a4b50] flex items-center justify-center relative shadow-inner">
                                    </div>

                                <div class="mt-3 flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] p-3 rounded-lg shadow-sm">
                                    <span id="fileNameDisplay" class="truncate max-w-[200px] lg:max-w-[400px] text-slate-700 dark:text-slate-200"></span>
                                    <span id="fileSizeDisplay" class="bg-slate-100 dark:bg-[#2a2b2e] px-2.5 py-1 rounded-md border border-slate-200 dark:border-[#4a4b50]"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-8 bg-amber-50 dark:bg-amber-900/10 border-l-4 border-amber-500 p-5 rounded-r-xl">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <i class="fa-solid fa-triangle-exclamation text-amber-500 text-lg"></i>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-bold text-amber-800 dark:text-amber-400">Modificación de Borrador</h3>
                                    <div class="mt-2 text-sm text-amber-700 dark:text-amber-500/80 leading-relaxed">
                                        <p>Cualquier archivo nuevo que subas <strong class="text-amber-900 dark:text-amber-300">reemplazará</strong> de forma permanente al PDF actual de este borrador.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="mt-10 pt-6 border-t border-slate-100 dark:border-[#4a4b50] flex justify-end space-x-3 transition-colors duration-300">
                    <a href="/admin/Documents/Index" class="bg-slate-100 dark:bg-[#2a2b2e] hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-bold py-3 px-6 rounded-xl transition duration-150">
                        Cancelar y Volver
                    </a>
                    <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold py-3 px-8 rounded-xl shadow-md shadow-amber-500/20 flex items-center transition duration-150">
                        <i class="fa-solid fa-save mr-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // ==========================================
            // LÓGICA DE VISTA PREVIA DEL DOCUMENTO (EDIT)
            // ==========================================
            const fileInput = document.getElementById('newFile'); // Atado a newFile
            const uploadPrompt = document.getElementById('uploadPrompt');
            const previewContainer = document.getElementById('previewContainer');
            const filePreview = document.getElementById('filePreview');
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            const fileSizeDisplay = document.getElementById('fileSizeDisplay');
            let currentObjectUrl = null;

            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        fileNameDisplay.textContent = file.name;
                        fileSizeDisplay.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

                        uploadPrompt.classList.add('hidden');
                        previewContainer.classList.remove('hidden');

                        if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);

                        if (file.type === 'application/pdf') {
                            currentObjectUrl = URL.createObjectURL(file);
                            filePreview.innerHTML = `<iframe src="${currentObjectUrl}#toolbar=0&navpanes=0" class="absolute inset-0 w-full h-full border-0"></iframe>`;
                        } 
                        else if (file.type.startsWith('image/')) {
                            currentObjectUrl = URL.createObjectURL(file);
                            filePreview.innerHTML = `<img src="${currentObjectUrl}" class="absolute inset-0 w-full h-full object-contain bg-slate-100 dark:bg-[#2a2b2e] p-2" alt="Vista previa" />`;
                        } 
                        else {
                            let iconClass = 'fa-file-lines text-slate-400';
                            let fileTypeName = 'Documento';

                            if(file.name.toLowerCase().endsWith('.doc') || file.name.toLowerCase().endsWith('.docx')) {
                                iconClass = 'fa-file-word text-blue-500';
                                fileTypeName = 'Word';
                            }
                            if(file.name.toLowerCase().endsWith('.xls') || file.name.toLowerCase().endsWith('.xlsx')) {
                                iconClass = 'fa-file-excel text-emerald-500';
                                fileTypeName = 'Excel';
                            }
                            
                            filePreview.innerHTML = `
                                <div class="absolute inset-0 w-full h-full bg-white dark:bg-[#323338] text-center p-6 flex flex-col items-center justify-center">
                                    <i class="fa-solid ${iconClass} text-6xl mb-4 opacity-90 drop-shadow-sm"></i>
                                    <p class="text-sm font-bold text-slate-700 dark:text-slate-200">Archivo de ${fileTypeName} Listo</p>
                                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-2 px-4">
                                        Los navegadores web no previsualizan archivos de Office localmente. Tu archivo se ha adjuntado con éxito y reemplazará al borrador actual.
                                    </p>
                                </div>
                            `;
                        }
                    }
                });
            }

            window.removeFile = function() {
                fileInput.value = ''; 
                uploadPrompt.classList.remove('hidden'); 
                previewContainer.classList.add('hidden'); 
                filePreview.innerHTML = ''; 
                if (currentObjectUrl) {
                    URL.revokeObjectURL(currentObjectUrl);
                    currentObjectUrl = null;
                }
            };
        });
    </script>
}