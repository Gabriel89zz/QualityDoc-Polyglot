@using QualityDoc.API.Helpers
@model PaginatedList<QualityDoc.API.Models.Company>

@{
    ViewData["Title"] = "Gestión de Empresas Clientes";
}

<div class="w-full max-w-7xl mx-auto space-y-6">
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white dark:bg-[#323338] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] transition-colors duration-300">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center">
                <div class="w-10 h-10 rounded-xl bg-brand/10 flex items-center justify-center mr-3 border border-brand/20">
                    <i class="fa-solid fa-building text-brand"></i>
                </div>
                Empresas Clientes
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Panel de administración global (Multi-tenant)</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a asp-action="Create" class="bg-brand hover:bg-brand-hover text-white font-bold py-2.5 px-5 rounded-xl shadow-md shadow-brand/20 flex items-center transition duration-200">
                <i class="fa-solid fa-plus mr-2"></i> Alta de Empresa
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" id="searchForm" class="flex flex-col md:flex-row gap-3 mb-2 relative z-40 animate-fade-up">
        
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </span>
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" autocomplete="off" placeholder="Buscar por razón social o RFC..." 
                   class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] rounded-xl text-sm focus:outline-none focus:border-brand dark:focus:border-brand shadow-sm transition-all text-slate-700 dark:text-slate-200" />
        </div>

        <div class="relative inline-block text-left" id="filterDropdownContainer">
            <button type="button" id="btnFilterToggle" class="h-full inline-flex justify-center items-center gap-2 rounded-xl border border-slate-200 dark:border-[#4a4b50] shadow-sm px-4 py-2.5 bg-white dark:bg-[#323338] text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition-colors focus:outline-none focus:ring-2 focus:ring-brand/20">
                <i class="fa-solid fa-filter text-slate-400"></i> Estado 
                @if(!string.IsNullOrEmpty((string)ViewData["CurrentStatus"]))
                {
                    <span class="ml-1 bg-brand text-white text-[10px] px-2 py-0.5 rounded-full shadow-sm">1</span>
                }
                <i class="fa-solid fa-chevron-down text-[10px] ml-1"></i>
            </button>

            <div id="filterMenu" class="hidden absolute right-0 mt-2 w-64 rounded-2xl shadow-xl bg-white dark:bg-[#323338] border border-slate-200 dark:border-[#4a4b50] z-50 p-4 transform origin-top-right transition-all">
                <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">Filtrar por Estado</span>
                <div class="flex flex-wrap gap-2">
                    
                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @(string.IsNullOrEmpty((string)ViewData["CurrentStatus"]) ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Todos
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="Active" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Active" ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Solo Activos
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="status" value="Inactive" class="peer sr-only" onchange="document.getElementById('searchForm').submit();" @((string)ViewData["CurrentStatus"] == "Inactive" ? "checked" : "")>
                        <div class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-[#4a4b50] bg-slate-50 dark:bg-[#2a2b2e] text-slate-600 dark:text-slate-400 text-xs font-bold transition-colors peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand shadow-sm">
                            Solo Inactivos
                        </div>
                    </label>
                </div>
            </div>
        </div>

        @if(!string.IsNullOrEmpty((string)ViewData["CurrentSearch"]) || !string.IsNullOrEmpty((string)ViewData["CurrentStatus"]))
        {
            <a asp-action="Index" class="bg-slate-100 hover:bg-red-50 dark:bg-[#323338] dark:hover:bg-red-500/10 text-slate-500 hover:text-red-500 dark:text-slate-400 px-4 py-2.5 rounded-xl font-bold shadow-sm transition-colors flex items-center border border-slate-200 dark:border-[#4a4b50]" title="Limpiar filtros">
                <i class="fa-solid fa-xmark"></i>
            </a>
        }
    </form>
    <!-- ========================================== -->
    <!-- 🚀 ALERTAS DE ERROR Y ÉXITO -->
    <!-- ========================================== -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 p-4 rounded-r-xl shadow-sm border border-y-red-100 border-r-red-100 dark:border-transparent transition-colors duration-300">
            <div class="flex items-center">
                <i class="fa-solid fa-triangle-exclamation text-red-500 text-lg mr-3"></i>
                <p class="text-sm text-red-700 dark:text-red-400 font-bold">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-500 p-4 rounded-r-xl shadow-sm border border-y-green-100 border-r-green-100 dark:border-transparent transition-colors duration-300">
            <div class="flex items-center">
                <i class="fa-solid fa-circle-check text-green-500 text-lg mr-3"></i>
                <p class="text-sm text-green-700 dark:text-green-400 font-bold">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }
    <!-- ========================================== -->

    <div class="bg-white dark:bg-[#323338] rounded-2xl shadow-sm border border-slate-200 dark:border-[#4a4b50] overflow-hidden transition-colors duration-300">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 dark:bg-[#2a2b2e] text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider transition-colors duration-300">
                    <tr>
                        <th class="p-4 font-semibold">Razón Social</th>
                        <th class="p-4 font-semibold">RFC / Tax ID</th>
                        <th class="p-4 font-semibold">Estado</th>
                        <th class="p-4 font-semibold">Fecha de Alta</th>
                        <th class="p-4 font-semibold text-center">Acciones</th>
                    </tr>
                </thead>
                
                <tbody class="divide-y divide-slate-100 dark:divide-[#4a4b50] text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="p-12 text-center text-slate-500 dark:text-slate-400">
                                <i class="fa-regular fa-building text-4xl mb-3 text-slate-300 dark:text-slate-600 block"></i>
                                <h5 class="text-lg font-bold text-slate-700 dark:text-slate-300 mb-1">Sin empresas registradas</h5>
                                <p class="text-sm">No hay empresas clientes dadas de alta en el sistema actualmente.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-[#2a2b2e] transition duration-150">
                                <td class="p-4 font-bold text-slate-800 dark:text-white">
                                    <div class="flex items-center">
                                        <div class="h-8 w-8 rounded-lg bg-slate-100 dark:bg-[#2a2b2e] border border-slate-200 dark:border-[#4a4b50] flex items-center justify-center text-slate-500 dark:text-slate-400 mr-3 shadow-sm">
                                            <i class="fa-solid fa-briefcase text-xs"></i>
                                        </div>
                                        @item.LegalName
                                    </div>
                                </td>
                                
                                <td class="p-4 text-slate-600 dark:text-slate-400 font-mono text-xs font-semibold">
                                    <span class="bg-slate-100 dark:bg-[#2a2b2e] px-2 py-1 rounded border border-slate-200 dark:border-[#4a4b50]">
                                        @item.TaxId
                                    </span>
                                </td>
                                
                                <td class="p-4">
                                    @if (item.Status == "Active")
                                    {
                                        <span class="inline-flex items-center bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 px-2.5 py-1 rounded-full text-xs font-bold border border-green-200 dark:border-green-800/30 w-max">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 px-2.5 py-1 rounded-full text-xs font-bold border border-red-200 dark:border-red-800/30 w-max">
                                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span> Inactivo
                                        </span>
                                    }
                                </td>
                                
                                <td class="p-4 text-slate-500 dark:text-slate-400 font-medium">
                                    @item.CreatedAt.ToLocalTime().ToString("dd MMMM, yyyy", new System.Globalization.CultureInfo("es-MX"))
                                </td>
                                
                                <td class="p-4 text-center flex justify-center items-center space-x-4">
                                    <a asp-action="Details" asp-route-id="@item.CompanyId" class="text-slate-400 hover:text-brand dark:hover:text-brand transition" title="Ver Detalles de Trazabilidad">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (item.Status == "Active")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.CompanyId" class="text-slate-400 hover:text-amber-500 transition" title="Editar Configuración">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.CompanyId" method="post" class="inline-block m-0 p-0">
                                            <button type="submit" class="text-slate-400 hover:text-red-500 dark:hover:text-red-400 transition bg-transparent border-none p-0 cursor-pointer" title="Suspender Inquilino" onclick="return confirm('¿Estás seguro de suspender esta empresa?');">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 dark:text-slate-600 cursor-not-allowed" title="Restaura la empresa para poder editarla">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </span>

                                        <form asp-action="Reactivate" asp-route-id="@item.CompanyId" method="post" class="inline-block m-0 p-0" onsubmit="return confirm('¿Estás seguro de que deseas reactivar esta empresa y a su Administrador (QA Manager)?');">
                                            <button type="submit" class="text-slate-400 hover:text-green-500 transition bg-transparent border-none p-0 cursor-pointer" title="Reactivar Empresa">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <div class="bg-slate-50 dark:bg-[#2a2b2e] px-4 py-4 border-t border-slate-200 dark:border-[#4a4b50] flex flex-col sm:flex-row items-center justify-between transition-colors duration-300">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-4 sm:mb-0">
                Mostrando página <span class="font-bold text-slate-800 dark:text-white">@Model.PageIndex</span> de <span class="font-bold text-slate-800 dark:text-white">@Model.TotalPages</span>
            </div>
            
            <div class="flex space-x-2">
                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   asp-route-search="@ViewData["CurrentSearch"]"
                   asp-route-status="@ViewData["CurrentStatus"]"
                   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
                   @(Model.HasPreviousPage 
                        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
                        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
                    <i class="fa-solid fa-chevron-left mr-1"></i> Anterior
                </a>

                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                   asp-route-search="@ViewData["CurrentSearch"]"
                   asp-route-status="@ViewData["CurrentStatus"]"
                   class="px-4 py-2 text-xs font-bold rounded-lg border transition-colors shadow-sm
                   @(Model.HasNextPage 
                        ? "text-slate-600 bg-white border-slate-300 hover:bg-slate-50 hover:text-brand dark:bg-[#323338] dark:border-[#4a4b50] dark:text-slate-300 dark:hover:bg-brand/20 dark:hover:border-brand" 
                        : "text-slate-400 border-slate-200 bg-slate-100 cursor-not-allowed pointer-events-none dark:bg-[#2a2b2e] dark:border-[#323338] dark:text-slate-600")">
                    Siguiente <i class="fa-solid fa-chevron-right ml-1"></i>
                </a>
            </div>
        </div>
        
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnFilterToggle = document.getElementById('btnFilterToggle');
            const filterMenu = document.getElementById('filterMenu');

            if(btnFilterToggle && filterMenu) {
                // Abrir/Cerrar menú
                btnFilterToggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    filterMenu.classList.toggle('hidden');
                });

                // Cerrar al dar click afuera
                document.addEventListener('click', (e) => {
                    if (!filterMenu.contains(e.target) && !btnFilterToggle.contains(e.target)) {
                        filterMenu.classList.add('hidden');
                    }
                });

                // Prevenir que se cierre al dar click adentro
                filterMenu.addEventListener('click', (e) => e.stopPropagation());
            }
        });
    </script>
}